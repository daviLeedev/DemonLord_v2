  m_Script: {fileID: 11500000, guid: cd459bb966771d34e8506cc3c1aa98b9, type: 3}
  m_Name: CombatLiaisonBriefing
  m_EditorClassIdentifier: DemonLord.Runtime::DemonLord.Presentation.Exploration.DialogueSequence
  player:
    speakerId: tax-officer
    displayName: "\uC138\uBB34\uAD00"
    portrait: {fileID: 21300000, guid: e7b7bf8011753304189594089264c265, type: 3}
  partner:
    speakerId: combat-liaison-officer
    displayName: "\uC804\uD22C \uB300\uC751 \uC9D1\uD589\uAD00"
    portrait: {fileID: 21300000, guid: 5960f27a7a24a3d4cbbbddf57c906159, type: 3}
  lines:
  - speakerSide: 1
    text: "\uC138\uBB34\uAD00\uB2D8, \uC870\uC815 \uB300\uC0C1\uC758 \uC801\uB300
      \uBC18\uC751\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4."
    portraitVariantId: neutral
  - speakerSide: 1
    text: "\uC88C\uCE21\uC758 \uC791\uC740 \uC544\uAD70 \uBAA9\uB85D\uC5D0\uC11C
      \uB300\uC0C1\uC744 \uACE0\uB974\uBA74 \uBC14\uB85C \uC606\uC5D0 \uADF8 \uC778\uC6D0\uC758
      \uAE30\uC220\uC774 \uD45C\uC2DC\uB429\uB2C8\uB2E4. \uBD89\uC740 \uACE1\uC120
      \uD654\uC0B4\uC740 \uC801\uC758 \uACF5\uAC1C \uD589\uB3D9\uC785\uB2C8\uB2E4."
    portraitVariantId: neutral
  - speakerSide: 1
    text: "\uACF5\uC720 SP \uC548\uC5D0\uC11C \uAC01\uC790 \uAE30\uC220\uC744 \uACE0\uB974\uBA74,
      \uAE30\uC220\uC758 \uC18D\uB3C4\uC5D0 \uB530\uB77C \uC544\uAD70\uACFC \uC801\uC758
      \uD589\uB3D9\uC120\uC774 \uB2E4\uC2DC \uC815\uB82C\uB429\uB2C8\uB2E4. \uB2E4\uC74C\uC744
      \uB204\uB974\uBA74 \uC2DC\uC791\uD569\uB2C8\uB2E4."
    portraitVariantId: neutral
