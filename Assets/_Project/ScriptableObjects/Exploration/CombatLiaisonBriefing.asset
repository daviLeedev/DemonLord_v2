    portrait: {fileID: 0}
  lines:
  - speakerSide: 1
    text: "\uC138\uBB34\uAD00\uB2D8, \uC870\uC815 \uB300\uC0C1\uC758 \uC801\uB300
      \uBC18\uC751\uC774 \uD655\uC778\uB410\uC2B5\uB2C8\uB2E4."
    portraitVariantId: neutral
  - speakerSide: 0
    text: "\uC804\uD22C \uAD6C\uC5ED \uC88C\uD45C\uC640 \uD604\uC7A5 \uAE30\uB85D\uBD80\uD130
      \uD655\uBCF4\uD574 \uC8FC\uC138\uC694."
    portraitVariantId: neutral
  - speakerSide: 1
    text: "\uC88C\uD45C\uB294 \uD655\uBCF4\uD588\uC2B5\uB2C8\uB2E4. \uCD9C\uB3D9
      \uC2B9\uC778\uC774 \uB0B4\uB824\uC624\uBA74 \uC989\uC2DC \uC548\uB0B4\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    portraitVariantId: neutral
