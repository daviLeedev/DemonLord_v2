  m_Script: {fileID: 11500000, guid: cd459bb966771d34e8506cc3c1aa98b9, type: 3}
  m_Name: WorldlineResearcherIntroduction
  m_EditorClassIdentifier: DemonLord.Runtime::DemonLord.Presentation.Exploration.DialogueSequence
  player:
    speakerId: tax-officer
    displayName: "\uC138\uBB34\uAD00"
    portrait: {fileID: 21300000, guid: e7b7bf8011753304189594089264c265, type: 3}
  partner:
    speakerId: worldline-researcher
    displayName: "\uC138\uACC4\uC120 \uBD84\uC11D \uC5F0\uAD6C\uC6D0"
    portrait: {fileID: 21300000, guid: 53b84f37ebdb76947b5fe4fd8b50b454, type: 3}
  lines:
  - speakerSide: 1
    text: "\uC138\uBB34\uAD00\uB2D8, \uC81C3\uAD00\uCE21\uC2E4\uC758 \uC138\uACC4\uC120
      \uBCC0\uB3D9\uCE58\uAC00 \uB2E4\uC2DC \uC0C1\uC2B9\uD558\uACE0 \uC788\uC2B5\uB2C8\uB2E4."
    portraitVariantId: neutral
  - speakerSide: 0
    text: "\uC2B9\uC778\uB418\uC9C0 \uC54A\uC740 \uC870\uC815 \uAE30\uB85D\uBD80\uD130
      \uBD84\uB9AC\uD574 \uC8FC\uC138\uC694. \uD604\uC7A5\uC740 \uC81C\uAC00 \uD655\uC778\uD558\uACA0\uC2B5\uB2C8\uB2E4."
    portraitVariantId: neutral
  - speakerSide: 1
    text: "\uACA9\uB9AC \uC5F0\uAD6C\uC2E4\uC740 \uC544\uC9C1 \uBD09\uC1C4 \uC0C1\uD0DC\uC785\uB2C8\uB2E4.
      \uC811\uADFC \uD5C8\uAC00 \uC5C6\uC774 \uBB38\uC744 \uC5F4 \uC218 \uC5C6\uC2B5\uB2C8\uB2E4."
    portraitVariantId: neutral
  - speakerSide: 0
    text: "\uC54C\uACA0\uC2B5\uB2C8\uB2E4. \uC6B0\uC120 \uACF5\uAC1C\uB41C \uAE30\uB85D\uBD80\uD130
      \uAC80\uD1A0\uD558\uC8E0."
    portraitVariantId: neutral
